# SAL Project .gitignore

# ===========================
# Node.js Dependencies
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ===========================
# DuckDB Cache Files
# ===========================
*.duckdb
*.duckdb.wal
plan-cache.duckdb*
embedding-cache.duckdb*

# ===========================
# LLM Models (Large Files)
# ===========================
models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# ===========================
# Transformers.js Cache
# ===========================
.cache/
transformers-cache/
**/onnx/

# ===========================
# Environment & Secrets
# ===========================
.env.local
.env.*.local
*.key
*.pem
secrets/

# ===========================
# IDE & Editor Files
# ===========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===========================
# Logs & Debugging
# ===========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ===========================
# Docker & Build Artifacts
# ===========================
.docker/
docker-compose.override.yml
*.tar
*.gz

# ===========================
# Testing & Coverage
# ===========================
coverage/
.nyc_output/
test-results/
*.test.log

# ===========================
# Temporary Files
# ===========================
tmp/
temp/
*.tmp
*.temp
.cache/

# ===========================
# OS Generated Files
# ===========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ===========================
# Project Specific
# ===========================
# Keep .env.example for documentation
.env
!.env.example

# Screenshots & debug output
screenshots/
debug/
*.png
*.jpg
*.jpeg
!docs/**/*.png
!docs/**/*.jpg

# Backup files
*.bak
*.backup

# ===========================
# Documentation Build
# ===========================
docs/.build/
docs/_site/

# ===========================
# Optional: Rename Summary
# ===========================
RENAME_SUMMARY.md
